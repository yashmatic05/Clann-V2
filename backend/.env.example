# Required application configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=clann

# Required admin authentication configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_A_BCRYPT_PASSWORD_HASH
ADMIN_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: admin login token lifetime in hours (defaults to 8)
ADMIN_TOKEN_TTL_HOURS=8
